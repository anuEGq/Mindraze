# Copy to .env.local (development) or .env.production (server) and fill in.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.

# --- Site -------------------------------------------------------------------
# Live domain, used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# --- Contact details (leave empty to show labelled placeholders) ------------
NEXT_PUBLIC_CONTACT_PHONE= 9947545545 , 7012877692
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number in international format, digits only, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Full office address (use \n for line breaks). Enables LocalBusiness schema together with the phone.
NEXT_PUBLIC_OFFICE_ADDRESS=
# Google Maps embed URL: Google Maps > Share > Embed a map > copy the src="..." value
NEXT_PUBLIC_MAP_EMBED_URL=

# --- Social profiles (empty = shown as "link to be added") ------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# --- Enquiry delivery ---------------------------------------------------------
# Long random string used to sign form tokens (e.g. `openssl rand -hex 32`).
ENQUIRY_SECRET=
# Absolute folder for the append-only enquiry log (enquiries.ndjson). `npm start` defaults it to ./.data
ENQUIRY_LOG_DIR=
# Email delivery through Resend (https://resend.com). All three are needed for email.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Mindraze Global Website <website@your-domain.com>"
# Optional: POST every enquiry as JSON to a webhook (CRM, Zapier, Google Apps Script…)
ENQUIRY_WEBHOOK_URL=

# --- Spam protection (optional, Cloudflare Turnstile) -----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Reverse proxy ------------------------------------------------------------
# Header carrying the real client IP (default: x-real-ip, then x-forwarded-for).
CLIENT_IP_HEADER=
